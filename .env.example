# Copy to .env and fill in what you need. Anything unset falls back to a
# development-friendly default.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TZ=America/Caracas

# Which design direction the React app renders: a | b | c
PORTFOLIO_THEME=a

# --- Content language ---
# Used when a request carries no ?lang=, X-Language or Accept-Language we
# recognise. The full set lives in settings.CONTENT_LANGUAGES.
PORTFOLIO_DEFAULT_LANG=en

# --- Media in S3 ---
# Empty: uploads stay in backend/media/. Set: every media URL becomes a
# short-lived presigned GET, so the bucket can stay private.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_REGION_NAME=us-east-1

# Key prefix, so one bucket can hold several environments.
AWS_S3_LOCATION=media
# Signature lifetime in seconds. URLs are cached for just under this, so it also
# bounds how stale a page's media links can be.
AWS_S3_SIGNATURE_TTL=3600
# Turn signing off ONLY when a public CDN fronts the bucket.
AWS_S3_SIGN_URLS=1
AWS_S3_CUSTOM_DOMAIN=
# Set for S3-compatible stores (MinIO, R2, B2).
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=virtual
# Overwrite on name collision instead of suffixing.
AWS_S3_FILE_OVERWRITE=0
AWS_S3_CACHE_CONTROL=max-age=86400
# A private bucket wants no ACL; set one only for pre-Object-Ownership buckets.
AWS_DEFAULT_ACL=
