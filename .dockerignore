# Build output the image regenerates, and state that must never be baked in.
.git/
.github/
.env
*.md

# Python
__pycache__/
*.py[cod]
backend/.venv/
venv/
backend/staticfiles/

# Local state. In production the SQLite file lives on an EBS volume.
backend/db.sqlite3
backend/db.sqlite3.bak-*
backend/media/

# Regenerated by stage 1; a stale local build would shadow it.
backend/portfolio/static/app/
frontend/node_modules/
npm-debug.log*

# Reference material, not application code.
infra/
.DS_Store
.idea/
.vscode/
